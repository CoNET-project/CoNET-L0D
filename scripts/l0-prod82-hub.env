# Production L0 hub on 216.225.202.82 (overlay VIP 100.64.0.7).
# Source before start-geth-beacon-only.sh restart-l0-only / enable-l0-dht on spokes.
# Beacon --peer / peer_id: scripts/l1-beacon-static-peers.env (do not curl .98 :4100).
# Canonical: lab-secrets/82/summary.json
#
# Inbound overlay geth: hub keeps public advertise. Other geth (with conet-l0d +
# a [[peers]] row on this hub) admin_addPeer L0_OVERLAY_ENODE below — do not
# change .82 --nat to the overlay VIP (that would break public bootnodes).
# Hub HTTP for admin_* is :8889. Do not restart .82 geth for addPeer.

_L1_PEERS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/l1-beacon-static-peers.env"
if [[ -f "$_L1_PEERS" ]]; then
	# shellcheck disable=SC1090
	source "$_L1_PEERS"
fi
unset _L1_PEERS

export L0_DHT_HUB_PUBLIC_IP=216.225.202.82
export L0_DHT_HUB_OVERLAY_VIP=100.64.0.7

export L0_OVERLAY_ENODE='enode://f1e249c97ce861441b3bd4832213cc634dd5c23d1a8722cd9c1aea28492779f6b64e012e8d97d56006d69be5224903ea5a787d8af68e9542db82ac1f76491dd5@100.64.0.7:8400'
# Lab .98 overlay geth (HTTP :8889). Hub admin_removePeer public @198.251.77.98:8400 first.
export L0_OVERLAY_ENODE_98='enode://006561987aaeea06a6f2c54d37656a4acccd0c1e16c9025700be1cfc45c6b79596293426694f0cf5eccacc1f92392628a93adb52c607b86b78f8601e5247459b@100.64.0.6:8400'
export L0_PUBLIC_ENODE_82='enode://f1e249c97ce861441b3bd4832213cc634dd5c23d1a8722cd9c1aea28492779f6b64e012e8d97d56006d69be5224903ea5a787d8af68e9542db82ac1f76491dd5@216.225.202.82:8400'
export L0_PUBLIC_ENODE_98='enode://006561987aaeea06a6f2c54d37656a4acccd0c1e16c9025700be1cfc45c6b79596293426694f0cf5eccacc1f92392628a93adb52c607b86b78f8601e5247459b@198.251.77.98:8400'
# Overlay beacon peer_id is pinned with --p2p-static-id in 06_restart_node66.sh
# start_beacon (systemd ExecStart → start). Keys: consensus/beacondata/network-keys.
# Do not systemctl restart conet-node66.service (that would bounce geth+validator).
# Do not curl .98 :4100 for identity (HTTP 500 / nil ENR). Public --peer uses the
# same peer_id with the hub public IP (L0_ONLY allowlist refuses those).
export L0_OVERLAY_BEACON_PEER="${L1_BEACON_OVERLAY_PEER_82:-/ip4/100.64.0.7/tcp/4200/p2p/16Uiu2HAmDJCHuVkXtkPrrL8YykQ9gFZnQkR9Q6WjZZUrmueohPfd}"
# Extra static CL peer: lab .98 overlay VIP (wallet-addressed). Primary hub remains .82.
# Note: needs L0 reachability .45→100.64.0.6:4200; without it Prysm will dial-backoff.
# Do not re-enable full dual-hub L0 mesh (SI exclusive occupy) — see l0-dual-hub.env.disabled.
export EXTRA_BEACON_PEERS="${L1_BEACON_OVERLAY_PEER_98:-/ip4/100.64.0.6/tcp/4200/p2p/16Uiu2HAmF1SXGHnne9DQTHGfgGQgje3cBV8pdSLJF25ajYKr2hvS}"
unset L0_EXTRA_OVERLAY_ENODES

# Spoke overlay-dht-steer.sh (PEER_* = hub)
export PEER_PUBLIC_IP=216.225.202.82
export PEER_OVERLAY_VIP=100.64.0.7

# Optional discv5 bootstrap from hub localhost identity (REST is 127.0.0.1:4100 on .82 only).
# .98 :4100 identity returns HTTP 500 when --no-discovery. Do not refresh peer_id from it.
export L0_DHT_BOOTSTRAP_ENR='enr:-Mq4QPeML9LZiOYZYlcVf4quakT5ssa-xJX4V8F480wA2NnMfIgzWoqrbbaTfFbgihiwB_z0rtx1EN1c8MHR4D6-0mCGAaAd0bEgh2F0dG5ldHOIAAAAAAAAMACEZXRoMpBuufdeIAAAkwBMBgAAAAAAgmlkgnY0gmlwhNjhylKEcXVpY4IyyIlzZWNwMjU2azGhAwmH_g6FfLyLSc9DEhh5auDVFzTdrGPftKkEZk0uFtsYiHN5bmNuZXRzD4N0Y3CCEGiDdWRwghDM'
