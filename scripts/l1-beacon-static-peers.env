# Canonical CoNET L1 production / lab-hub beacon identities (Prysm :4200).
# Single source of truth for other nodes that join via static --peer.
#
# These IDs are pinned with --p2p-static-id + beacondata/network-keys.
# Pinning the ID does NOT by itself complete overlay join. Overlay still needs
# hub toml [[peers]], ordered conet-l0d bounce, and overlay-beacon-listen-dnat.
# .98 uses --no-discovery + allowlist; unlisted overlay joiners are not
# accepted just because --peer is correct.
#
# Do NOT:
#   - curl .98 :4100 /eth/v1/node/identity for this ID (HTTP 500: nil ENR when
#     --no-discovery). Read beacon.log "Running node with peer id of …" or
#     this file.
#   - confuse DHT sidecar :4110 peer_id with production beacon :4200
#     (.82 DHT id 16Uiu2HAmGnXx… is NOT a beacon --peer).
#   - wipe beacondata / run restart-beacon-clean (mints a new peer_id).
#   - systemctl restart conet-node66.service (bounces geth + validator).
#   - restart geth / beacon / validator without same-message written approval.
#
# Verify geth was not restarted: read geth.pid. Never pgrep -n geth.
# Keys live under consensus/beacondata/network-keys. Backups MUST sit
# outside beacondata (wipe of that dir deletes in-tree copies).
# 2026-08-22 copies (file, 64 bytes, mode 600; sha256 matched source):
#   .82 ~/ethereum-pos-mainnet/secrets/l1-beacon-network-keys/node66-beacondata-network-keys
#   .98 ~/ethereum-pos-mainnet/secrets/l1-beacon-network-keys/node0-beacondata-network-keys

# --- Production hub .82 (216.225.202.82 / overlay 100.64.0.7) ---
export L1_BEACON_PEER_ID_82="16Uiu2HAmDJCHuVkXtkPrrL8YykQ9gFZnQkR9Q6WjZZUrmueohPfd"
export L1_BEACON_PUBLIC_IP_82="216.225.202.82"
export L1_BEACON_OVERLAY_VIP_82="100.64.0.7"
export L1_BEACON_OVERLAY_PEER_82="/ip4/${L1_BEACON_OVERLAY_VIP_82}/tcp/4200/p2p/${L1_BEACON_PEER_ID_82}"
export L1_BEACON_PUBLIC_PEER_82="/ip4/${L1_BEACON_PUBLIC_IP_82}/tcp/4200/p2p/${L1_BEACON_PEER_ID_82}"
# Same node id as public bootnode; dest is overlay VIP. Hub keeps public --nat.
export L1_GETH_OVERLAY_ENODE_82="enode://f1e249c97ce861441b3bd4832213cc634dd5c23d1a8722cd9c1aea28492779f6b64e012e8d97d56006d69be5224903ea5a787d8af68e9542db82ac1f76491dd5@100.64.0.7:8400"

# --- Lab / shared hub .98 (198.251.77.98 / overlay 100.64.0.6) ---
export L1_BEACON_PEER_ID_98="16Uiu2HAmF1SXGHnne9DQTHGfgGQgje3cBV8pdSLJF25ajYKr2hvS"
export L1_BEACON_PUBLIC_IP_98="198.251.77.98"
export L1_BEACON_OVERLAY_VIP_98="100.64.0.6"
export L1_BEACON_OVERLAY_PEER_98="/ip4/${L1_BEACON_OVERLAY_VIP_98}/tcp/4200/p2p/${L1_BEACON_PEER_ID_98}"
export L1_BEACON_PUBLIC_PEER_98="/ip4/${L1_BEACON_PUBLIC_IP_98}/tcp/4200/p2p/${L1_BEACON_PEER_ID_98}"
export L1_GETH_OVERLAY_ENODE_98="enode://006561987aaeea06a6f2c54d37656a4acccd0c1e16c9025700be1cfc45c6b79596293426694f0cf5eccacc1f92392628a93adb52c607b86b78f8601e5247459b@100.64.0.6:8400"

# Compatibility aliases used by start-geth-beacon-only.sh / l0-prod82-hub.env.
# Do NOT export EXTRA_BEACON_PEERS here (that auto-enables dual-hub).
export L0_OVERLAY_BEACON_PEER="${L0_OVERLAY_BEACON_PEER:-$L1_BEACON_OVERLAY_PEER_82}"
