# DISABLED by default: SI exclusive occupy cannot mesh .45↔.82↔.98.
# While .45↔.82 holds channel listens, EXTRA_BEACON_PEERS to 100.64.0.6 causes
# dial backoff and dual-hub l0_connect 409. Keep this file as *.disabled so
# start-geth-beacon-only.sh does not source it (it only sources l0-dual-hub.env).
# To experiment with dual-hub again, rename to l0-dual-hub.env only after .82
# releases .98/.45 occupies (or SI multi-client occupy ships).
#
# Requires l0-prod82-hub.env sourced first (primary enode/beacon = .7).
# Static overlay only — do not enable L0_DHT (steer is single-hub).

# export L0_DHT=0
# export L0_EXTRA_OVERLAY_ENODES='enode://006561987aaeea06a6f2c54d37656a4acccd0c1e16c9025700be1cfc45c6b79596293426694f0cf5eccacc1f92392628a93adb52c607b86b78f8601e5247459b@100.64.0.6:8400'
# export EXTRA_BEACON_PEERS='/ip4/100.64.0.6/tcp/4200/p2p/16Uiu2HAmF1SXGHnne9DQTHGfgGQgje3cBV8pdSLJF25ajYKr2hvS'
# export L0_GETH_MAXPEERS=4
